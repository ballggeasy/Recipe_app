PORT=3000
# REQUIRED. The server refuses to start without it; in production it must be >= 32 random chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
DB_PATH=./data/app.sqlite
# Where uploaded images are stored and served from at /uploads/ (default: ./uploads)
# UPLOADS_DIR=./uploads
# LOCAL DEVELOPMENT ONLY. Enables POST /auth/reset-password and GET /auth/exists/:email, which
# identify the account by email alone, so anyone could take over any account. Never set in production.
# ALLOW_INSECURE_PASSWORD_RESET=true
# Only used by docker-compose (Grafana login for user "admin"). Choose your own value.
GRAFANA_ADMIN_PASSWORD=
# Optional hardening (defaults shown in docs/DEPLOYMENT.md)
# Comma-separated browser origins allowed by CORS (Flutter web). Native apps don't need it.
# CORS_ORIGINS=https://app.example.com
# Sign in with Google: comma-separated OAuth client IDs whose ID tokens are accepted (the audience).
# Use the Web client ID (the Android app asks Google for a token for that same ID). Without it,
# POST /auth/google answers 503 and nobody can sign in with Google.
# GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com
# Number of reverse proxies in front of the app; needed for correct per-IP rate limiting behind one.
# TRUST_PROXY=1
# RATE_LIMIT_PER_MINUTE=120
# AUTH_RATE_LIMIT_PER_MINUTE=10
# Compose only: bind Grafana to localhost (reach it through an SSH tunnel).
# GRAFANA_BIND=127.0.0.1
