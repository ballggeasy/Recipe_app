{
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "testRegex": "\\.e2e-spec\\.ts$",
  "moduleFileExtensions": ["js", "json", "ts"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.spec.json" }]
  },
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/setup-e2e-env.ts"],
  "testTimeout": 30000
}
